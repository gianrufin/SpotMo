name: Import Ticketmelon events

on:
  schedule:
    - cron: '10 15 * * *' # daily, end of day (staggered from the other importers)
  workflow_dispatch: {}

permissions:
  contents: read

jobs:
  import:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - run: node scripts/import-ticketmelon.mjs
        env:
          SUPABASE_URL: https://obdqfvniwblessnmesfj.supabase.co
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
