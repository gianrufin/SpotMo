# Copy to .env and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Google Places (New) API key for venue autocomplete.
# Google Cloud Console → APIs & Services → Credentials → Create API key,
# then restrict it: Application restrictions → HTTP referrers (your domain +
# localhost for dev); API restrictions → Places API (New) only.
# Leave blank to use the free, keyless OpenStreetMap fallback instead.
VITE_GOOGLE_PLACES_KEY=
